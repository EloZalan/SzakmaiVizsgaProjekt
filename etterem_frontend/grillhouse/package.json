{
  "name": "grillhouse",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production --base-href /schmitzhofer.pal/frontend/ --deploy-url /schmitzhofer.pal/frontend/",
    "build:ftp": "ng build --configuration production --base-href ./ --deploy-url ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run --e2e",
    "e2e:run:chrome": "cypress run --e2e --browser chrome"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "jspdf": "^4.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "cypress": "^15.13.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
